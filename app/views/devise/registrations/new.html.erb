<div class="account-page">
  <h1>新規登録</h1>

  <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), local: true do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field"><%= f.label :nickname, "ニックネーム" %><%= f.text_field :nickname, autofocus: true %></div>
    <div class="field"><%= f.label :email, "メールアドレス" %><%= f.email_field :email, autocomplete: "email" %></div>
    <div class="field"><%= f.label :password, "パスワード（6文字以上・半角英数字混合）" %><%= f.password_field :password, autocomplete: "new-password" %></div>
    <div class="field"><%= f.label :password_confirmation, "パスワード（確認）" %><%= f.password_field :password_confirmation, autocomplete: "new-password" %></div>
    <div class="field"><%= f.label :last_name, "名字（全角）" %><%= f.text_field :last_name %></div>
    <div class="field"><%= f.label :first_name, "名前（全角）" %><%= f.text_field :first_name %></div>
    <div class="field"><%= f.label :last_name_kana, "名字カナ（全角）" %><%= f.text_field :last_name_kana %></div>
    <div class="field"><%= f.label :first_name_kana, "名前カナ（全角）" %><%= f.text_field :first_name_kana %></div>
    <div class="field">
      <%= f.label :birth_date, "生年月日" %>
      <%= f.date_select :birth_date, start_year: 1930, end_year: Date.current.year,
                                     use_month_numbers: true, prompt: "--" %>
    </div>
    <div class="actions"><%= f.submit "会員登録" %></div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
